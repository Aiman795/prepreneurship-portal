# Copy this file to ".env" and fill in real values.
# Never commit the real .env file - it's already in .gitignore.

# ---- Database ----
# Local MongoDB for development. Ask Shafaat for the staging URI later.
MONGO_URI=mongodb://localhost:27017/prepreneurship-portal

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Auth ----
# Long random string used to sign admin JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Admin login. Password is stored as a bcrypt HASH, never plain text.
# Generate a hash for your chosen password with:
#   npm run hash-password
# (it will prompt you for a password and print the hash to paste below)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# ---- CORS ----
# Comma-separated list of frontend URLs allowed to call this API.
# Add your local dev URL now; add the deployed frontend URL once it exists.
ALLOWED_ORIGINS=http://localhost:5173
